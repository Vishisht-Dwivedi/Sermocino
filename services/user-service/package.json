{
  "name": "user-service",
  "version": "1.0.0",
  "type": "module",
  "description": "Microservice which is responsible for managing user data",
  "main": "dist/index.js",
  "scripts": {
    "dev:api": "dotenv tsx watch src/index.ts",
    "dev:grpc": "dotenv pnpm exec tsx src/grpc/server.js",
    "db:fk": "tsx --env-file=.env scripts/apply-fk.ts",
    "db:push": "prisma migrate dev && pnpm db:fk",
    "dev": "concurrently -n API,GRPC -c blue,green \"pnpm dev:api\" \"pnpm dev:grpc\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pnpm:gen": "prisma generate"
  },
  "keywords": [
    "user"
  ],
  "author": "Vishisht Dwivedi",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.2",
    "@sermocino/grpc-contracts": "workspace:*",
    "@sermocino/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
