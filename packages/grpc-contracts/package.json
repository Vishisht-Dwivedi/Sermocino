{
  "name": "@sermocino/grpc-contracts",
  "version": "1.0.0",
  "description": "Central proto definitions and generated gRPC contracts",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "generated",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "clean": "rm -rf generated && mkdir -p generated",
    "proto:gen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,forceLong=string,useOptionals=messages proto/*.proto",
    "build": "pnpm clean && pnpm proto:gen"
  },
  "keywords": [
    "grpc",
    "protobuf",
    "contracts"
  ],
  "author": "Vishisht Dwivedi",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "ts-proto": "^2.11.6"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.14.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "wire": "link:@bufbuild/protobuf/wire"
  }
}
